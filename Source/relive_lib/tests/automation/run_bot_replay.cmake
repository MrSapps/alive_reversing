# Runs the bot (SCRIPT_PLAY, which saves its buttons to %INPUTS% and a hash_log to %OUT%), then plays the buttons
# back with no bot (SCRIPT_REPLAY), and fails unless the two hash logs agree on the game frames they share.
# Skips if there's no game data. Pass RELIVE, DATA_DIR, SCRIPT_PLAY, SCRIPT_REPLAY and WORK_DIR.
if (NOT DATA_DIR OR NOT EXISTS "${DATA_DIR}/relive_data")
    message("No converted game data in '${DATA_DIR}': skipping")
    return()
endif()
set(ENV{SDL_VIDEO_DRIVER} offscreen)
set(ENV{SDL_AUDIO_DRIVER} dummy)
set(ENV{ASAN_OPTIONS} detect_leaks=0)
file(MAKE_DIRECTORY "${WORK_DIR}")
set(INPUTS "${WORK_DIR}/inputs.txt")
foreach (run play replay)
    if (run STREQUAL "play")
        file(READ "${SCRIPT_PLAY}" template)
    else()
        file(READ "${SCRIPT_REPLAY}" template)
    endif()
    string(REPLACE "%OUT%" "${WORK_DIR}/hash_${run}.txt" script "${template}")
    string(REPLACE "%INPUTS%" "${INPUTS}" script "${script}")
    file(WRITE "${WORK_DIR}/script_${run}.txt" "${script}")
    execute_process(COMMAND "${RELIVE}" "-automation=${WORK_DIR}/script_${run}.txt" -max_fps=0 ${GAME_ARGS}
        WORKING_DIRECTORY "${DATA_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if (NOT result EQUAL 0)
        file(WRITE "${WORK_DIR}/log_${run}.txt" "${out}")
        message(FATAL_ERROR "${run}: relive exited with ${result}, see ${WORK_DIR}/log_${run}.txt")
    endif()
endforeach()
file(STRINGS "${WORK_DIR}/hash_play.txt" played)
file(STRINGS "${WORK_DIR}/hash_replay.txt" replayed)
# A frame can be logged more than once: while a camera loads the frame number stands still, and the bot plays
# frames again after it died and went back. The last time counts: that is the run its buttons are of.
set(frames "")
foreach (a IN LISTS played)
    string(REGEX MATCH "^[0-9]+" frame "${a}")
    set(played_${frame} "${a}")
endforeach()
foreach (b IN LISTS replayed)
    string(REGEX MATCH "^[0-9]+" frame "${b}")
    if (NOT DEFINED replayed_${frame})
        list(APPEND frames ${frame})
    endif()
    set(replayed_${frame} "${b}")
endforeach()
set(shared 0)
foreach (frame IN LISTS frames)
    if (DEFINED played_${frame})
        math(EXPR shared "${shared} + 1")
        if (NOT played_${frame} STREQUAL replayed_${frame})
            message(FATAL_ERROR "The replay isn't the game the bot played: frame ${frame}\n  bot:    ${played_${frame}}\n  replay: ${replayed_${frame}}\nSee ${WORK_DIR}")
        endif()
    endif()
endforeach()
if (shared EQUAL 0)
    message(FATAL_ERROR "The two runs logged no game frame in common: see ${WORK_DIR}")
endif()
message("The replay matches the bot's run on ${shared} frames")
