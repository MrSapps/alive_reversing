# Runs relive twice with the same -automation script, which logs a hash of the whole world on every
# frame (hash_log), and fails at the first frame the two logs differ. Skips if there's no game data.
# Pass RELIVE, DATA_DIR, SCRIPT and WORK_DIR (where the logs go).
if (NOT DATA_DIR OR NOT EXISTS "${DATA_DIR}/relive_data")
    message("No converted game data in '${DATA_DIR}': skipping")
    return()
endif()
set(ENV{SDL_VIDEO_DRIVER} offscreen)
set(ENV{SDL_AUDIO_DRIVER} dummy)
set(ENV{ASAN_OPTIONS} detect_leaks=0)
file(MAKE_DIRECTORY "${WORK_DIR}")
file(READ "${SCRIPT}" template)
foreach (run 1 2)
    set(OUT "${WORK_DIR}/hash${run}.txt")
    string(REPLACE "%OUT%" "${OUT}" script "${template}")
    file(WRITE "${WORK_DIR}/script${run}.txt" "${script}")
    execute_process(COMMAND "${RELIVE}" "-automation=${WORK_DIR}/script${run}.txt" ${GAME_ARGS}
        WORKING_DIRECTORY "${DATA_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if (NOT result EQUAL 0)
        message(FATAL_ERROR "run ${run}: relive exited with ${result}")
    endif()
endforeach()
file(STRINGS "${WORK_DIR}/hash1.txt" lines1)
file(STRINGS "${WORK_DIR}/hash2.txt" lines2)
list(LENGTH lines1 count1)
list(LENGTH lines2 count2)
if (NOT count1 EQUAL count2)
    message(FATAL_ERROR "The runs logged ${count1} and ${count2} lines")
endif()
set(frame "")
set(index 0)
foreach (a b IN ZIP_LISTS lines1 lines2)
    if (NOT a MATCHES "^ ")
        set(frame "${a}")
    endif()
    if (NOT a STREQUAL b)
        message(FATAL_ERROR "Not deterministic: line ${index}, frame '${frame}':\n  run 1: ${a}\n  run 2: ${b}\nSee ${WORK_DIR}")
    endif()
    math(EXPR index "${index} + 1")
endforeach()
